# Backend environment variables (copy to .env and export or load with your shell)

# Vision provider selection: Stub (default) or AWS
# VISION_PROVIDER=AWS

# AWS credentials (required if using AWS provider via environment variables)
# AWS_ACCESS_KEY_ID=your_key_id
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=ap-southeast-2

# Optionally pin the ASP.NET URLs
# ASPNETCORE_URLS=http://localhost:5088

